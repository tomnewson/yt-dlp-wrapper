#!/bin/sh
set -eu

echo "Checking Rust formatting..."
cargo fmt --all -- --check

echo "Checking all targets..."
cargo check --all-targets --locked

echo "Running tests..."
cargo test --all-targets --locked

echo "Running Clippy..."
cargo clippy --all-targets --locked -- -D warnings

echo "Checking .NET formatting..."
dotnet format YtDlpWrapper.slnx --verify-no-changes --no-restore

echo "Building and testing Avalonia..."
dotnet test YtDlpWrapper.slnx --no-restore -m:1 --disable-build-servers

echo "Pre-commit checks passed."
