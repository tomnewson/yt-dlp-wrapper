export global Palette {
    out property <color> background: #121619;
    out property <color> text-light: #f4f1e8;
    out property <color> text-dark: #121619;
    out property <color> background-highlight: #bcb382;
    out property <color> background-faded: #2d4739;
    out property <color> text-error: #a12525;
    out property <color> accent: #09814a;
}
