import { Button, CheckBox, LineEdit, ProgressIndicator, ScrollView, Slider, TextEdit } from "std-widgets.slint";
import { Palette } from "palette.slint";

export component AppWindow inherits Window {
    title: "yt-dlp-wrapper";
    preferred-width: 520px;
    preferred-height: 480px;
    min-width: 520px;
    min-height: 480px;
    background: Palette.background;

    in-out property <string> url: "";
    in-out property <string> output-folder: "";
    in-out property <bool> audio-only: false;
    in-out property <float> video-quality: 3;
    in-out property <bool> busy: true;
    in-out property <bool> cancellable: false;
    in-out property <bool> tools-ready: false;
    in-out property <bool> setup-required: false;
    in-out property <bool> update-available: false;
    in-out property <bool> can-install-tools: false;
    in-out property <bool> completed: false;
    in-out property <bool> failed: false;
    in-out property <bool> show-details: false;
    in-out property <bool> show-about: false;
    in-out property <float> progress: 0;
    in-out property <string> status-text: "Checking required tools…";
    in-out property <string> update-summary: "";
    in-out property <string> details-text: "";

    callback browse-output();
    callback start-download(string, bool, string, float);
    callback cancel-download();
    callback install-tools();
    callback defer-update();
    callback retry-tool-check();
    callback open-folder();

    ScrollView {
        width: 100%;
        height: 100%;
        viewport-width: self.visible-width;
        viewport-height: max(self.visible-height, content.min-height);

        content := VerticalLayout {
            padding: 28px;
            spacing: 16px;

            HorizontalLayout {
                height: 36px;
                vertical-stretch: 0;

                Text {
                    text: "yt-dlp-wrapper";
                    font-size: 24px;
                    font-weight: 700;
                    color: Palette.text-light;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Button {
                    text: "About";
                    width: 72px;
                    height: 36px;
                    vertical-stretch: 0;
                    clicked => { root.show-about = !root.show-about; }
                }
            }

            if root.show-about: Rectangle {
                background: Palette.background-highlight;
                border-radius: 8px;
                height: text.preferred-height + 24px;
                vertical-stretch: 0;
                text := Text {
                    x: 14px;
                    y: 12px;
                    width: parent.width - 28px;
                    text: "yt-dlp-wrapper is GPLv3 software. It uses Slint and manages yt-dlp, FFmpeg, and Deno. Third-party licence files are stored with downloaded tools.";
                    wrap: word-wrap;
                    color: Palette.text-dark;
                }
            }

            if root.setup-required: Rectangle {
                background: Palette.background-faded;
                border-radius: 8px;
                height: 120px;
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    Text { text: "Required tools are not installed."; font-weight: 700; color: Palette.text-light; }
                    Text { text: root.update-summary; wrap: word-wrap; color: Palette.text-light; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: root.busy ? "Working…" : "Install tools"; enabled: !root.busy && root.can-install-tools; clicked => { root.install-tools(); } }
                        Button { text: "Retry check"; enabled: !root.busy; clicked => { root.retry-tool-check(); } }
                    }
                }
            }

            if root.update-available && !root.setup-required: Rectangle {
                background: Palette.background-faded;
                border-radius: 8px;
                height: 110px;
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    Text { text: "Tool updates are available."; font-weight: 700; color: Palette.text-light; }
                    Text { text: root.update-summary; wrap: word-wrap; color: Palette.text-light; }
                    HorizontalLayout {
                        Button { text: "Update"; enabled: !root.busy && root.can-install-tools; clicked => { root.install-tools(); } }
                        Button { text: "Later"; enabled: !root.busy; clicked => { root.defer-update(); } }
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;
                vertical-stretch: 0;

                Text {
                    text: "Video URL";
                    font-weight: 600;
                    color: Palette.text-light;
                    vertical-stretch: 0;
                }
                LineEdit {
                    height: 36px;
                    vertical-stretch: 0;
                    text <=> root.url;
                    placeholder-text: "https://…";
                    enabled: root.tools-ready && !root.busy;
                }
            }

            VerticalLayout {
                spacing: 4px;
                vertical-stretch: 0;

                Text {
                    text: "Video quality";
                    font-weight: 600;
                    color: Palette.text-light;
                    vertical-stretch: 0;
                }
                Slider {
                    height: 20px;
                    vertical-stretch: 0;
                    minimum: 0;
                    maximum: 3;
                    step: 1;
                    value <=> root.video-quality;
                    enabled: root.tools-ready && !root.busy && !root.audio-only;
                }
                HorizontalLayout {
                    height: 16px;
                    vertical-stretch: 0;

                    Text { text: "1080p"; color: Palette.text-light; horizontal-stretch: 1; }
                    Text { text: "1440p"; color: Palette.text-light; horizontal-stretch: 1; horizontal-alignment: center; }
                    Text { text: "4K"; color: Palette.text-light; horizontal-stretch: 1; horizontal-alignment: center; }
                    Text { text: "Best"; color: Palette.text-light; horizontal-stretch: 1; horizontal-alignment: right; }
                }
            }

            CheckBox {
                height: 28px;
                vertical-stretch: 0;
                text: "Audio only (M4A with AAC)";
                checked <=> root.audio-only;
                enabled: root.tools-ready && !root.busy;
            }

            VerticalLayout {
                spacing: 6px;
                vertical-stretch: 0;

                Text {
                    text: "Output folder";
                    font-weight: 600;
                    color: Palette.text-light;
                    vertical-stretch: 0;
                }
                HorizontalLayout {
                    height: 36px;
                    vertical-stretch: 0;
                    spacing: 8px;

                    LineEdit {
                        height: 36px;
                        vertical-stretch: 0;
                        text <=> root.output-folder;
                        read-only: true;
                        horizontal-stretch: 1;
                    }
                    Button {
                        width: 84px;
                        height: 36px;
                        vertical-stretch: 0;
                        text: "Browse…";
                        enabled: !root.busy;
                        clicked => { root.browse-output(); }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            ProgressIndicator {
                vertical-stretch: 0;
                progress: root.progress;
                indeterminate: root.busy && root.progress == 0;
            }
            status-container := Rectangle {
                height: max(status-label.preferred-height, 20px);
                vertical-stretch: 0;

                status-label := Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.status-text;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    color: root.failed ? Palette.text-error : Palette.text-light;
                }

                if root.completed: TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-folder(); }
                }
            }

            HorizontalLayout {
                height: 36px;
                vertical-stretch: 0;

                if !root.busy: Button {
                    text: "Download";
                    enabled: root.tools-ready && root.url != "" && root.output-folder != "" && !root.update-available;
                    clicked => { root.start-download(root.url, root.audio-only, root.output-folder, root.video-quality); }
                }
                if root.busy && root.cancellable: Button { text: "Cancel"; clicked => { root.cancel-download(); } }
                if root.details-text != "": Button {
                    text: root.show-details ? "Hide details" : "Show details";
                    clicked => { root.show-details = !root.show-details; }
                }
            }

            if root.show-details: TextEdit {
                vertical-stretch: 1;
                min-height: 72px;
                text: root.details-text;
                read-only: true;
                wrap: word-wrap;
            }

        }
    }
}
